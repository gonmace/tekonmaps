# Dockerfile para desarrollo con MariaDB
# Uso: docker compose -f docker-compose.mariadb.yml up --build

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Dependencias para mysqlclient
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    default-libmysqlclient-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/mysql.txt requirements/base.txt ./
RUN pip install --no-cache-dir -r mysql.txt

# Para dev: instalar también django-browser-reload, tailwind, etc.
COPY requirements/dev.txt ./
RUN pip install --no-cache-dir -r dev.txt || true

COPY . .

EXPOSE 8000

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
