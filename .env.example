# Copia a .env y ajusta. Recomendado: generar con `make setup`.
# NO pongas credenciales reales en este archivo: va al repositorio. Usa placeholders.

# ── Proyecto ──────────────────────────────────────────────────────────────────
PROJECT_NAME=pti-tekon-rl-cl
DOMAIN=pti.tekon-rl.cl

# ── Puerto ────────────────────────────────────────────────────────────────────
APP_PORT=8008

# ── Django ────────────────────────────────────────────────────────────────────
# Genera uno: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=cambia-esto-por-una-clave-aleatoria
DEBUG=False
ALLOWED_HOSTS=pti.tekon-rl.cl
CSRF_TRUSTED_ORIGINS=https://pti.tekon-rl.cl
ADMIN_URL=admin/
# SECURE_SSL_REDIRECT=False   # desactivar si el proxy ya fuerza HTTPS

# ── Nextcloud (Docs. Finales) ─────────────────────────────────────────────────
# URL base del share de Nextcloud para la carpeta 20-PTI SP.
NEXTCLOUD_FINAL_BASE=

# ── Nextcloud (acceso directo WebDAV) ─────────────────────────────────────────
# Usuario de servicio con app-password. BASE_URL apunta a la raíz de archivos
# del usuario. Necesita escritura en /20-ITO_SEGUIMIENTO y lectura en el resto.
NEXTCLOUD_BASE_URL=https://tu-nextcloud/remote.php/dav/files/usuario-servicio/
NEXTCLOUD_USER=usuario-servicio
NEXTCLOUD_APP_PASSWORD=app-password-de-nextcloud
# Carpeta con los templates descargables de los documentos esperados (vacío = sin descarga).
NEXTCLOUD_TEMPLATES_PATH=/00-TEMPLATES
# Seguimiento ITO: segundos que se reusa el snapshot sin reconsultar Nextcloud.
# 0 = siempre consulta (producción). En desarrollo usar p. ej. 600 para refrescos rápidos.

# ── Base de datos ─────────────────────────────────────────────────────────────
# Por defecto SQLite (db.sqlite3). Para usar PostgreSQL, descomenta estas líneas:
DATABASE_NAME=base
DATABASE_USER=usuario-db
DATABASE_PASSWORD=cambia-esto-por-una-contraseña
DATABASE_HOST=postgres
DATABASE_PORT=5432

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Sin EMAIL_HOST se usa el backend de consola.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu@email.com
# EMAIL_HOST_PASSWORD=tu-contraseña-de-app
# DEFAULT_FROM_EMAIL=noreply@pti.tekon-rl.cl
