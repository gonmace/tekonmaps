# Desarrollo: manage.py usa core.settings.dev (no requiere variables)
# Producción: docker compose usa core.settings.prod

# Obligatorias en producción
DJANGO_SECRET_KEY=tu-clave-secreta-muy-larga-y-aleatoria
DATABASE_PASSWORD=tu-password-postgres

# Opcionales (tienen defaults)
DATABASE_NAME=tekonmaps
DATABASE_USER=magoreal
DATABASE_HOST=db
DATABASE_PORT=5432

# URL base compartida de Nextcloud para Docs. Finales (carpeta 20-PTI SP)
# NEXTCLOUD_FINAL_BASE=https://cloud2.tekon-rl.cl/s/TOKEN

# Si el dominio es distinto a pti.tekon-rl.cl
# ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com
# CSRF_TRUSTED_ORIGINS=https://tu-dominio.com
